{
  "manifest_version": 3,
  "name": "域流量管家 · 浏览器活动诊断",
  "version": "0.6.0",
  "description": "在用户启用后记录网页请求的实际传输字节、URL、资源类型和浏览器下载记录，不读取 HTTPS 正文。",
  "minimum_chrome_version": "109",
  "key": "",
  "permissions": [
    "debugger",
    "downloads",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "域流量管家 · 浏览器活动诊断",
    "default_popup": "popup.html"
  }
}
